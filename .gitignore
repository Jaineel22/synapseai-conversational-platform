# ─── Environment Variables ────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ─── Node Modules ─────────────────────────────────────────
# Bare pattern (no path prefix) so it matches at any depth regardless of
# the parent directory's case — Frontend/ and Backend/ are capitalized,
# so a `frontend/`-prefixed pattern would silently never match on a
# case-sensitive filesystem (Linux, i.e. every CI/deploy host).
node_modules/

# ─── Build Outputs ────────────────────────────────────────
# Also package-local (Frontend/.gitignore has its own `dist` entry) —
# kept here too, same case-sensitivity reasoning as above.
Frontend/dist/
Frontend/build/

# ─── Logs ─────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── OS Files ─────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── IDE & Editor ─────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ─── Vite ─────────────────────────────────────────────────
frontend/.vite/

# ─── Misc ─────────────────────────────────────────────────
*.tgz
.npm
.eslintcache
