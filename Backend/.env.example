# Copy this file to .env and fill in real values. Never commit .env itself.

# Express server port (optional — defaults to 8080)
PORT=8080

# development | production — controls cookie flags and the Vercel serverless branch in server.js
NODE_ENV=development

# MongoDB connection string (e.g. a MongoDB Atlas URI)
MONGODB_URI=

# Secret used to sign/verify JWTs — generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Google Gemini API key (from https://aistudio.google.com/)
GEMINI_API_KEY=

# Exact origin of the deployed frontend, used for CORS (e.g. https://your-app.vercel.app)
CLIENT_ORIGIN=
