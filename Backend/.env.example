# Copy this file to .env and fill in real values. Never commit .env itself.

# Express server port (optional — defaults to 8080)
PORT=8080

# development | production — controls cookie flags (secure/sameSite) in routes/auth.js.
# Set this explicitly in every deployment's environment settings — hosts are not
# guaranteed to set it for you, and an incorrect value breaks cross-origin login.
NODE_ENV=development

# MongoDB connection string (e.g. a MongoDB Atlas URI) — required
MONGODB_URI=

# Secret used to sign/verify JWTs — required, generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Google Gemini API key (from https://aistudio.google.com/) — required
GEMINI_API_KEY=

# Exact origin of the deployed frontend, used for CORS — required, no trailing slash.
#   Local:      http://localhost:5173
#   Production: the frontend's deployed origin (e.g. https://your-app.vercel.app)
CLIENT_ORIGIN=

# Set automatically by Vercel — do not set this manually and do not set it on Render.
# server.js uses its presence to decide whether to call app.listen() (skipped on
# Vercel's serverless runtime) or run as a normal long-running process (Render, local).
# VERCEL=1

# ─── Optional tuning (all have sane defaults if left unset) ────────────────

# How many recent thread messages are sent to Gemini as conversation context.
# MAX_CONTEXT_MESSAGES=20

# Hard timeout (ms) on a single Gemini call before it's treated as failed.
# GEMINI_TIMEOUT_MS=60000

# Rate limits — requests per window, per client.
# AUTH_RATE_LIMIT=20             (per 15 minutes, per IP — register + login combined)
# CHAT_RATE_LIMIT=15             (per minute, per authenticated user)
# DOCUMENT_UPLOAD_RATE_LIMIT=20  (per 15 minutes, per authenticated user)

# ─── RAG / document knowledge base (Phase 5) — all optional, sane defaults ──

# Gemini embedding model used for both document chunks and search queries.
# EMBEDDING_MODEL=gemini-embedding-001

# Output embedding vector size (Matryoshka truncation — gemini-embedding-001
# supports this). Must stay consistent for the life of the data: changing it
# after documents already exist makes old embeddings incomparable to new
# ones (there is no migration for this — re-upload documents if you change it).
# EMBEDDING_DIMENSIONS=768

# How many chunk texts are sent to the embeddings API per request — batches
# a whole document into a handful of calls instead of one call per chunk.
# EMBEDDING_BATCH_SIZE=50

# Chunking — character-based, paragraph/sentence-aware. See Backend/services/chunking.js.
# RAG_CHUNK_SIZE=1200
# RAG_CHUNK_OVERLAP=200
# RAG_MIN_CHUNK_SIZE=100

# Retrieval — how many chunks are retrieved per RAG query, and the cosine-
# similarity floor (0-1) below which a chunk is treated as irrelevant noise
# rather than included in the prompt.
# RAG_TOP_K=5
# RAG_MIN_SIMILARITY=0.55
# RAG_MAX_CHUNK_CHARS_IN_PROMPT=1500

# Maximum uploaded document size, in megabytes.
# DOCUMENT_MAX_FILE_SIZE_MB=10
