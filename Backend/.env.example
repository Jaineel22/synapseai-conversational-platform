# Copy this file to .env and fill in real values. Never commit .env itself.

# Express server port (optional — defaults to 8080)
PORT=8080

# development | production — controls cookie flags (secure/sameSite) in routes/auth.js.
# Set this explicitly in every deployment's environment settings — hosts are not
# guaranteed to set it for you, and an incorrect value breaks cross-origin login.
NODE_ENV=development

# MongoDB connection string (e.g. a MongoDB Atlas URI) — required
MONGODB_URI=

# Secret used to sign/verify JWTs — required, generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Google Gemini API key (from https://aistudio.google.com/) — required
GEMINI_API_KEY=

# Exact origin of the deployed frontend, used for CORS — required, no trailing slash.
#   Local:      http://localhost:5173
#   Production: the frontend's deployed origin (e.g. https://your-app.vercel.app)
CLIENT_ORIGIN=

# Set automatically by Vercel — do not set this manually and do not set it on Render.
# server.js uses its presence to decide whether to call app.listen() (skipped on
# Vercel's serverless runtime) or run as a normal long-running process (Render, local).
# VERCEL=1
