# Copy relevant values into .env.development (local) or your hosting
# platform's environment variable settings (production). Never commit
# real production values into a tracked .env file.

# Backend API base URL used by axios (see src/App.jsx).
#
# Local development: leave this EMPTY. Vite's dev proxy (vite.config.js)
# forwards /api requests to http://localhost:8080, so no absolute URL is
# needed — this is what Frontend/.env.development already does.
#
# Production: set this in your hosting platform's dashboard (e.g. Vercel
# project settings) to the deployed backend's origin, no trailing slash —
# e.g. https://your-service.onrender.com. Do not hardcode it in source.
#
# If you ever migrate/rename the backend deployment, this is the ONE place
# that needs updating on the frontend side — and it's easy to miss, because
# a stale value here can fail silently: if the old backend URL is still
# alive and still serves older routes (e.g. auth), login/chat can keep
# working normally while newer endpoints just don't exist there yet, with
# no obvious error pointing at the real cause. After changing this value
# you must trigger a new deployment — Vite bakes it in at build time, so
# editing it in the dashboard alone does not affect an already-built
# deployment.
VITE_API_URL=
